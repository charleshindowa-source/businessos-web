# Copy this file to .env and fill in the values Firebase shows you when you
# register a "Web app" inside your Firebase project (Project settings → your
# apps → SDK setup and configuration). These are safe to expose in a client
# bundle — see README.md "Security" section for what actually protects your
# data (Firestore/Storage rules + anonymous auth), which these values are not.
#
# For a GitHub Pages deploy, add the same six values as repository secrets
# (Settings → Secrets and variables → Actions) with these exact names —
# the deploy workflow reads them from there at build time.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
